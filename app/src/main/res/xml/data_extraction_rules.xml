<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in tokens are encrypted with a key that never leaves this phone,
     so they must not be backed up or copied to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
